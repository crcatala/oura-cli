{
  "name": "@crcatala/oura-cli",
  "version": "0.2.1",
  "description": "OAuth2-only TypeScript CLI for the Oura Ring API v2 (unofficial)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "oura": "dist/cli.js",
    "oura-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node scripts/require-live-test-env.mjs && vitest run tests/live --no-file-parallelism --maxWorkers=1",
    "test:package": "bash scripts/test-package.sh",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && npm run test && npm run lint && npm run typecheck && npm run test:package",
    "release": "release-it",
    "release:dry": "release-it --dry-run --no-npm --no-github",
    "release:first": "release-it --first-release",
    "release:prep": "bash scripts/prep-release.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "kleur": "^4.1.5"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@release-it/keep-a-changelog": "^8.0.0",
    "@types/node": "^24.0.0",
    "release-it": "^21.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
